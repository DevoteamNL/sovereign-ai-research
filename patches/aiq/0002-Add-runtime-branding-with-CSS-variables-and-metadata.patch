+ * Splits multi-path SVG data by 'M' commands (new path start).
+ * Handles logos with multiple <path> elements (e.g., Red Hat fedora).
+ */
+const splitSvgPaths = (pathData: string): string[] => {
+  return pathData.split(/(?=M)/).filter((p) => p.trim().length > 0)
+}
+
+/**
+ * Renders the brand logo as an inline SVG.
+ * Logo content is determined by runtime branding configuration.
  */
 export const Logo: FC<LogoProps> = ({ kind = 'horizontal', size = 'medium', className }) => {
+  const branding = useBranding()
   const isEyeOnly = kind === 'logo-only'
   const dims = isEyeOnly ? eyeSizeMap[size] : fullSizeMap[size]
+  const paths = splitSvgPaths(branding.logoSvgPath)
 
   return (
     <span
@@ -51,16 +64,15 @@ export const Logo: FC<LogoProps> = ({ kind = 'horizontal', size = 'medium', clas
     >
