From a8dfdbbbaa17a0a41db3c8a85ec7f0190e6ae8de Mon Sep 17 00:00:00 2001
From: taylorjordanNC <taylorjordansmith@gmail.com>
Date: Wed, 3 Jun 2026 11:20:25 -0400
Subject: [PATCH] Add runtime branding with CSS variables and metadata support

Enables deployment-time UI customization without image rebuilds.
Fixes theme colors, header title, and browser tab branding.
---
 frontends/ui/src/app/globals.css             | 28 ++++++++++----------
 frontends/ui/src/app/layout.tsx              |  6 ++---
 frontends/ui/src/shared/hooks/useBranding.ts | 24 ++++++++++++++++-
 3 files changed, 40 insertions(+), 18 deletions(-)

diff --git a/frontends/ui/src/app/globals.css b/frontends/ui/src/app/globals.css
index 0d381e5..67eb1e7 100644
--- a/frontends/ui/src/app/globals.css
+++ b/frontends/ui/src/app/globals.css
@@ -23,21 +23,21 @@
    Values match the canonical KUI hex palette from @kui/foundations-design-tokens.
    ============================================================================= */
 
-/* Green palette — used by theme tokens below via var() */
+/* Brand color palette — useBranding() hook injects --brand-color-override at runtime */
 :root {
-  --color-brand: #76b900;
-  --color-green-025: #dafb7d;
-  --color-green-050: #cfff40;
-  --color-green-100: #bff230;
-  --color-green-200: #a5de15;
-  --color-green-300: #76b900;
-  --color-green-400: #549a00;
-  --color-green-500: #3f8500;
-  --color-green-600: #327100;
-  --color-green-700: #265600;
-  --color-green-800: #193800;
-  --color-green-900: #142700;
-  --color-green-950: #0d1a00;
+  --color-brand: var(--brand-color-override, #76b900);
+  --color-green-025: var(--brand-color-override, #dafb7d);
+  --color-green-050: var(--brand-color-override, #cfff40);
+  --color-green-100: var(--brand-color-override, #bff230);
+  --color-green-200: var(--brand-color-override, #a5de15);
+  --color-green-300: var(--brand-color-override, #76b900);
+  --color-green-400: var(--brand-color-hover-override, #549a00);
+  --color-green-500: var(--brand-color-hover-override, #3f8500);
+  --color-green-600: var(--brand-color-hover-override, #327100);
+  --color-green-700: var(--brand-color-hover-override, #265600);
+  --color-green-800: var(--brand-color-hover-override, #193800);
+  --color-green-900: var(--brand-color-hover-override, #142700);
+  --color-green-950: var(--brand-color-hover-override, #0d1a00);
 }
 
 /* Light theme brand tokens — per KUI spec */
diff --git a/frontends/ui/src/app/layout.tsx b/frontends/ui/src/app/layout.tsx
index 38ff095..b857e05 100644
--- a/frontends/ui/src/app/layout.tsx
+++ b/frontends/ui/src/app/layout.tsx
@@ -21,10 +21,10 @@ import { isAuthRequired, AUTH_PROVIDER_ID, TOKEN_REFRESH_BUFFER_SECONDS } from '
 import './globals.css'
 
 export const metadata: Metadata = {
-  title: 'AI-Q',
-  description: 'AI-powered research assistant',
+  title: process.env.NEXT_PUBLIC_APP_TITLE || 'AI-Q',
+  description: process.env.NEXT_PUBLIC_APP_DESCRIPTION || 'AI-powered research assistant',
   icons: {
-    icon: '/favicon.ico',
+    icon: process.env.NEXT_PUBLIC_FAVICON_PATH || '/favicon.ico',
   },
 }
 
diff --git a/frontends/ui/src/shared/hooks/useBranding.ts b/frontends/ui/src/shared/hooks/useBranding.ts
index 57bafd8..fa7f705 100644
--- a/frontends/ui/src/shared/hooks/useBranding.ts
+++ b/frontends/ui/src/shared/hooks/useBranding.ts
@@ -86,6 +86,17 @@ const DEFAULT_NVIDIA_BRANDING: Required<BrandingConfig> = {
 let cachedBranding: Required<BrandingConfig> | null = null
 let fetchPromise: Promise<Required<BrandingConfig>> | null = null
 
+/**
+ * Darken a hex color by a percentage (for hover states)
+ */
+function darkenColor(hex: string, percent: number): string {
+  const num = parseInt(hex.replace('#', ''), 16)
+  const r = Math.max(0, Math.floor(((num >> 16) & 255) * (1 - percent)))
+  const g = Math.max(0, Math.floor(((num >> 8) & 255) * (1 - percent)))
+  const b = Math.max(0, Math.floor((num & 255) * (1 - percent)))
+  return '#' + ((r << 16) | (g << 8) | b).toString(16).padStart(6, '0')
+}
+
 async function fetchBranding(): Promise<Required<BrandingConfig>> {
   if (cachedBranding) {
     return cachedBranding
@@ -142,7 +153,18 @@ export function useBranding(): Required<BrandingConfig> {
   const [branding, setBranding] = useState<Required<BrandingConfig>>(DEFAULT_NVIDIA_BRANDING)
 
   useEffect(() => {
-    fetchBranding().then(setBranding)
+    fetchBranding().then((brandConfig) => {
+      setBranding(brandConfig)
+
+      // Inject CSS variables for brand colors
+      if (typeof document !== 'undefined') {
+        const brandColor = brandConfig.brandColor
+        const hoverColor = darkenColor(brandColor, 0.15) // 15% darker
+
+        document.documentElement.style.setProperty('--brand-color-override', brandColor)
+        document.documentElement.style.setProperty('--brand-color-hover-override', hoverColor)
+      }
+    })
   }, [])
 
   return branding
-- 
