From 5c8d7efea543404fef5df3615c1c7f508da69a70 Mon Sep 17 00:00:00 2001
From: taylorjordanNC <taylorjordansmith@gmail.com>
Date: Tue, 2 Jun 2026 09:08:52 -0400
Subject: [PATCH] Adding environment variable support for UI customization

---
 frontends/ui/src/adapters/ui/Logo.tsx         | 53 ++++++++++++++-----
 frontends/ui/src/app/layout.tsx               | 17 ++++--
 .../src/features/layout/components/AppBar.tsx | 11 ++--
 3 files changed, 58 insertions(+), 23 deletions(-)

diff --git a/frontends/ui/src/adapters/ui/Logo.tsx b/frontends/ui/src/adapters/ui/Logo.tsx
index 3330a62..3682364 100644
--- a/frontends/ui/src/adapters/ui/Logo.tsx
+++ b/frontends/ui/src/adapters/ui/Logo.tsx
@@ -4,11 +4,13 @@
 /**
  * Logo Component Shim
  *
- * Replaces the internal @kui/foundations-react Logo component which is
- * not available in the public @nvidia/foundations-react-core package.
- * Renders the NVIDIA eye mark as an inline SVG.
+ * Renders the brand logo as an inline SVG with configurable branding.
  *
- * The fill color is always NVIDIA green (#76b900), hardcoded in the SVG.
+ * Environment variables (all optional, defaults to NVIDIA branding):
+ * - NEXT_PUBLIC_BRAND_COLOR: Primary brand color (default: #76b900)
+ * - NEXT_PUBLIC_BRAND_NAME: Brand name for aria-label (default: NVIDIA)
+ * - NEXT_PUBLIC_LOGO_SVG_PATH: SVG path data (default: NVIDIA eye mark)
+ * - NEXT_PUBLIC_LOGO_VIEWBOX: SVG viewBox (default: 0 0 71 47)
  */
 
 import { type FC } from 'react'
@@ -35,14 +37,38 @@ const eyeSizeMap = {
 } as const
 
 /**
- * Renders the NVIDIA logo as an inline SVG.
- *
- * The fill color is always NVIDIA green (#76b900), driven by the
- * CSS variable `--nv-logo-image-color` set on `:root` in globals.css.
+ * Default NVIDIA logo SVG path data.
+ */
+const DEFAULT_NVIDIA_PATH =
+  'M7.255 20.234s6.419-9.476 19.236-10.455V6.34C12.294 7.481 0 19.51 0 19.51s6.963 20.138 26.491 21.982v-3.655C12.161 36.032 7.255 20.234 7.255 20.234zM26.49 30.57v3.346c-10.83-1.931-13.837-13.194-13.837-13.194s5.2-5.764 13.837-6.698v3.672l-.016-.002c-4.532-.544-8.074 3.692-8.074 3.692s1.984 7.131 8.09 9.184zm0-30.57v6.341c.417-.033.834-.06 1.253-.074 16.14-.544 26.658 13.242 26.658 13.242s-12.08 14.694-24.663 14.694c-1.153 0-2.234-.107-3.248-.287v3.92a21.24 21.24 0 002.704.176c11.71 0 20.18-5.982 28.38-13.063 1.359 1.089 6.925 3.738 8.07 4.9-7.797 6.529-25.968 11.792-36.27 11.792-.993 0-1.947-.06-2.884-.15V47H71V0H26.491zm0 14.024V9.78c.412-.03.829-.052 1.253-.065 11.607-.365 19.222 9.977 19.222 9.977S38.742 31.12 29.923 31.12c-1.27 0-2.407-.205-3.432-.55V17.697c4.52.546 5.428 2.543 8.145 7.073l6.042-5.096s-4.41-5.787-11.845-5.787c-.81 0-1.583.057-2.342.138z'
+
+/**
+ * Brand configuration from environment variables.
+ * Falls back to NVIDIA branding if not specified.
+ */
+const BRAND_CONFIG = {
+  color: process.env.NEXT_PUBLIC_BRAND_COLOR || '#76b900',
+  name: process.env.NEXT_PUBLIC_BRAND_NAME || 'NVIDIA',
+  svgPath: process.env.NEXT_PUBLIC_LOGO_SVG_PATH || DEFAULT_NVIDIA_PATH,
+  viewBox: process.env.NEXT_PUBLIC_LOGO_VIEWBOX || '0 0 71 47',
+} as const
+
+/**
+ * Splits multi-path SVG data by 'M' commands (new path start).
+ * Returns array of path data strings, each starting with 'M'.
+ * Handles logos with multiple <path> elements (e.g., Red Hat fedora).
+ */
+const splitSvgPaths = (pathData: string): string[] => {
+  return pathData.split(/(?=M)/).filter((p) => p.trim().length > 0)
+}
+
+/**
+ * Renders the brand logo as an inline SVG.
  */
 export const Logo: FC<LogoProps> = ({ kind = 'horizontal', size = 'medium', className }) => {
   const isEyeOnly = kind === 'logo-only'
   const dims = isEyeOnly ? eyeSizeMap[size] : fullSizeMap[size]
+  const paths = splitSvgPaths(BRAND_CONFIG.svgPath)
 
   return (
     <span
@@ -51,16 +77,15 @@ export const Logo: FC<LogoProps> = ({ kind = 'horizontal', size = 'medium', clas
     >
       <svg
         xmlns="http://www.w3.org/2000/svg"
-        viewBox="0 0 71 47"
+        viewBox={BRAND_CONFIG.viewBox}
         width={dims.width}
         height={dims.height}
-        aria-label="NVIDIA"
+        aria-label={BRAND_CONFIG.name}
         role="img"
       >
-        <path
-          d="M7.255 20.234s6.419-9.476 19.236-10.455V6.34C12.294 7.481 0 19.51 0 19.51s6.963 20.138 26.491 21.982v-3.655C12.161 36.032 7.255 20.234 7.255 20.234zM26.49 30.57v3.346c-10.83-1.931-13.837-13.194-13.837-13.194s5.2-5.764 13.837-6.698v3.672l-.016-.002c-4.532-.544-8.074 3.692-8.074 3.692s1.984 7.131 8.09 9.184zm0-30.57v6.341c.417-.033.834-.06 1.253-.074 16.14-.544 26.658 13.242 26.658 13.242s-12.08 14.694-24.663 14.694c-1.153 0-2.234-.107-3.248-.287v3.92a21.24 21.24 0 002.704.176c11.71 0 20.18-5.982 28.38-13.063 1.359 1.089 6.925 3.738 8.07 4.9-7.797 6.529-25.968 11.792-36.27 11.792-.993 0-1.947-.06-2.884-.15V47H71V0H26.491zm0 14.024V9.78c.412-.03.829-.052 1.253-.065 11.607-.365 19.222 9.977 19.222 9.977S38.742 31.12 29.923 31.12c-1.27 0-2.407-.205-3.432-.55V17.697c4.52.546 5.428 2.543 8.145 7.073l6.042-5.096s-4.41-5.787-11.845-5.787c-.81 0-1.583.057-2.342.138z"
-          fill="#76b900"
-        />
+        {paths.map((pathData, idx) => (
+          <path key={idx} d={pathData} fill={BRAND_CONFIG.color} />
+        ))}
       </svg>
     </span>
   )
diff --git a/frontends/ui/src/app/layout.tsx b/frontends/ui/src/app/layout.tsx
index 38ff095..6627d8f 100644
--- a/frontends/ui/src/app/layout.tsx
+++ b/frontends/ui/src/app/layout.tsx
@@ -21,10 +21,10 @@ import { isAuthRequired, AUTH_PROVIDER_ID, TOKEN_REFRESH_BUFFER_SECONDS } from '
 import './globals.css'
 
 export const metadata: Metadata = {
-  title: 'AI-Q',
-  description: 'AI-powered research assistant',
+  title: process.env.NEXT_PUBLIC_APP_TITLE || 'AI-Q',
+  description: process.env.NEXT_PUBLIC_APP_DESCRIPTION || 'AI-powered research assistant',
   icons: {
-    icon: '/favicon.ico',
+    icon: process.env.NEXT_PUBLIC_FAVICON_PATH || '/favicon.ico',
   },
 }
 
@@ -47,16 +47,25 @@ const RootLayout = async ({ children }: RootLayoutProps): Promise<ReactNode> =>
   await connection()
   const config = getAppConfig()
 
+  const customFontsUrl = process.env.NEXT_PUBLIC_FONTS_URL
+
   return (
     <html lang="en" id="style-root" suppressHydrationWarning>
       <head>
+        {customFontsUrl && (
+          <>
+            <link rel="preconnect" href="https://fonts.googleapis.com" />
+            <link rel="preconnect" href="https://fonts.gstatic.com" crossOrigin="anonymous" />
+            <link href={customFontsUrl} rel="stylesheet" />
+          </>
+        )}
         {/* CDN SVG icon loader - inlines <svg data-src="..."> elements */}
         <script
           src="https://unpkg.com/external-svg-loader@1.6.8/svg-loader.min.js"
           async
         />
       </head>
-      <body className="bg-surface-base">
+      <body className="bg-surface-base" suppressHydrationWarning>
         <Providers config={config}>{children}</Providers>
       </body>
     </html>
diff --git a/frontends/ui/src/features/layout/components/AppBar.tsx b/frontends/ui/src/features/layout/components/AppBar.tsx
index bcceeed..8e75938 100644
--- a/frontends/ui/src/features/layout/components/AppBar.tsx
+++ b/frontends/ui/src/features/layout/components/AppBar.tsx
@@ -86,7 +86,8 @@ export const AppBar: FC<AppBarProps> = memo(function AppBar({
   }, [isAuthenticated])
 
   const handleDocsClick = useCallback(() => {
-    window.open('https://github.com/NVIDIA-AI-Blueprints/aiq', '_blank')
+    const docsUrl = process.env.NEXT_PUBLIC_DOCS_URL || 'https://github.com/NVIDIA-AI-Blueprints/aiq'
+    window.open(docsUrl, '_blank')
   }, [])
 
   const handleNewSessionClick = useCallback(() => {
@@ -120,7 +121,7 @@ export const AppBar: FC<AppBarProps> = memo(function AppBar({
               <Logo kind="logo-only" size="small" />
 
               <Text kind="label/semibold/lg" className="text-primary whitespace-nowrap">
-                AI-Q
+                {process.env.NEXT_PUBLIC_BRAND_NAME || 'AI-Q'}
               </Text>
             </Flex>
           </Button>
@@ -241,9 +242,9 @@ export const AppBar: FC<AppBarProps> = memo(function AppBar({
               kind="primary"
               size="small"
               onClick={onSignIn}
-              aria-label="Sign in with NVIDIA SSO"
-              title="Sign in with NVIDIA SSO"
-              className="ml-2 bg-[#76b900] hover:bg-[#5a8f00]"
+              aria-label={`Sign in with ${process.env.NEXT_PUBLIC_BRAND_NAME || 'NVIDIA'} SSO`}
+              title={`Sign in with ${process.env.NEXT_PUBLIC_BRAND_NAME || 'NVIDIA'} SSO`}
+              className={`ml-2 ${process.env.NEXT_PUBLIC_SIGNIN_BUTTON_CLASS || 'bg-[#76b900] hover:bg-[#5a8f00]'}`}
             >
               <Flex align="center" gap="1">
                 <Lock className="h-4 w-4" />
