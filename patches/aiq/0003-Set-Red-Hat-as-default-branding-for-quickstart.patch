         // 404 is expected when no custom branding is deployed
         if (response.status === 404) {
-          console.log('No custom branding found, using NVIDIA defaults')
-          cachedBranding = DEFAULT_NVIDIA_BRANDING
+          console.log('No custom branding found, using Red Hat defaults')
+          cachedBranding = DEFAULT_BRANDING
           return cachedBranding
         }
         throw new Error(`Failed to fetch branding: ${response.status}`)
@@ -127,7 +127,7 @@ async function fetchBranding(): Promise<Required<BrandingConfig>> {
 
       // Merge custom branding with defaults
       cachedBranding = {
