From f163169f44d546d445976837b4fe11a3797d14b5 Mon Sep 17 00:00:00 2001
From: taylorjordanNC <taylorjordansmith@gmail.com>
Date: Wed, 3 Jun 2026 13:15:20 -0400
Subject: [PATCH] Set Red Hat as default branding for quickstart

Default to Red Hat branding to provide instant, polished UX for the
Red Hat AI quickstart. Eliminates the flash of NVIDIA branding that
occurred while fetching runtime configuration.

ConfigMap overrides still work - users can customize branding by
mounting a custom /branding/branding.json file to override default setting, or rebuild image without this patch.
---
 frontends/ui/src/shared/hooks/useBranding.ts | 46 ++++++++++----------
 1 file changed, 23 insertions(+), 23 deletions(-)

diff --git a/frontends/ui/src/shared/hooks/useBranding.ts b/frontends/ui/src/shared/hooks/useBranding.ts
index e8845ef..fe5d268 100644
--- a/frontends/ui/src/shared/hooks/useBranding.ts
+++ b/frontends/ui/src/shared/hooks/useBranding.ts
@@ -9,7 +9,7 @@
  * ## How it works
  *
  * 1. Attempts to fetch `/branding/branding.json` at runtime
- * 2. Falls back to NVIDIA AI-Q defaults if the file doesn't exist (404)
+ * 2. Falls back to Red Hat defaults if the file doesn't exist (404)
  * 3. Caches the result to avoid repeated fetches
  * 4. Injects CSS variables (--brand-color-override) for theme colors
  *
@@ -48,15 +48,15 @@
  *
  * ## Available branding fields
  *
- * All fields are optional. Omit any field to use the NVIDIA default.
+ * All fields are optional. Omit any field to use the Red Hat default.
  *
- * - `brandName`: Company/product name (default: "NVIDIA" or "AI-Q")
- * - `brandColor`: Primary brand color hex (default: "#76b900")
- * - `logoSvgPath`: SVG path data for logo (default: NVIDIA eye mark)
- * - `logoViewBox`: SVG viewBox (default: "0 0 71 47")
- * - `docsUrl`: Documentation link (default: NVIDIA AI-Q GitHub)
- * - `signinButtonClass`: Tailwind classes for sign-in button (default: NVIDIA green)
- * - `fontsUrl`: Google Fonts URL (optional)
+ * - `brandName`: Company/product name (default: "Red Hat Research")
+ * - `brandColor`: Primary brand color hex (default: "#EE0000")
+ * - `logoSvgPath`: SVG path data for logo (default: Red square)
+ * - `logoViewBox`: SVG viewBox (default: "0 0 40 40")
+ * - `docsUrl`: Documentation link (default: Red Hat AI Quickstarts)
+ * - `signinButtonClass`: Tailwind classes for sign-in button (default: Red Hat red)
+ * - `fontsUrl`: Google Fonts URL (optional, default: Red Hat Display + Text)
  */
 
 'use client'
@@ -73,15 +73,15 @@ export interface BrandingConfig {
   fontsUrl?: string
 }
 
-const DEFAULT_NVIDIA_BRANDING: Required<BrandingConfig> = {
-  brandName: 'NVIDIA',
-  brandColor: '#76b900',
