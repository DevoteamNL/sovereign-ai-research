# AI-Q Blueprint - Environment Configuration
#
# Copy to .env and set your values:
#   cp deploy/.env.example deploy/.env

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
PYTHONWARNINGS=ignore
AIQ_DEV_ENV=cli

# -----------------------------------------------------------------------------
# API Keys (required for core functionality)
# -----------------------------------------------------------------------------
NVIDIA_API_KEY=


# Web search (Required)
TAVILY_API_KEY=

# Paper search (Optional)
# SERPER_API_KEY=   # to enable, set API key and update the relevant config in configs/ directory


# -----------------------------------------------------------------------------
# Job store (async jobs)
# SQLite: sqlite+aiosqlite:///./data/jobs.db
# PostgreSQL: postgresql+asyncpg://user:pass@host:5432/aiq_jobs
# -----------------------------------------------------------------------------
# NAT_JOB_STORE_DB_URL=
# NAT_CONFIG_FILE=
# NAT_DASK_SCHEDULER_ADDRESS=
# Reduce Dask log noise (optional)
DASK_DISTRIBUTED__LOGGING__DISTRIBUTED=warning

# -----------------------------------------------------------------------------
# Checkpoint DB (LangGraph state)
# SQLite: ./checkpoints.db  |  PostgreSQL: postgresql://user:pass@host:5432/aiq_checkpoints
# -----------------------------------------------------------------------------
# AIQ_CHECKPOINT_DB=

# -----------------------------------------------------------------------------
# Summary DB (document summaries for agents)
# SQLite: sqlite+aiosqlite:///./summaries.db  |  PostgreSQL: postgresql+psycopg://...
# -----------------------------------------------------------------------------
# AIQ_SUMMARY_DB=

# -----------------------------------------------------------------------------
# Environment Variables for Modal Sandbox for Skills Execution (optional)
# -----------------------------------------------------------------------------
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

# -----------------------------------------------------------------------------
# Observability / Tracing (optional)
# See docs/source/deployment/observability.md for setup guides.
# -----------------------------------------------------------------------------
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=aiq-research
# WANDB_API_KEY=

# -----------------------------------------------------------------------------
# Evaluation (optional)
# -----------------------------------------------------------------------------
# JINA_API_KEY=

# -----------------------------------------------------------------------------
# Frontend File Upload Configuration
# -----------------------------------------------------------------------------
# These settings control file upload validation in the knowledge layer.
# Values should match backend limits for consistent user experience.

# Accepted file extensions (comma-separated, include leading dots).
# Default matches LlamaIndex backend. For Foundational RAG, add .pptx:
#   FILE_UPLOAD_ACCEPTED_TYPES=.pdf,.docx,.pptx,.txt,.md
FILE_UPLOAD_ACCEPTED_TYPES=.pdf,.docx,.txt,.md

# Maximum total file size in MB
FILE_UPLOAD_MAX_SIZE_MB=100

# Maximum number of files per session
FILE_UPLOAD_MAX_FILE_COUNT=10

# Hours after upload before files may expire on the backend (0 = no expiry shown),
#this should ideally match TTL of the files on the backend (e.g. 12 hours)
FILE_EXPIRATION_CHECK_INTERVAL_HOURS=0

# -----------------------------------------------------------------------------
# Embedding Model Environment Variables (optional, NVIDIA hosted models are used by default)
# -----------------------------------------------------------------------------
# AIQ_EMBED_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2
# AIQ_EMBED_BASE_URL=https://integrate.api.nvidia.com/v1
#
# VLM Model Environment Variables (optional, NVIDIA hosted models are used by default)
# AIQ_VLM_MODEL=nvidia/nemotron-nano-12b-v2-vl
# AIQ_VLM_BASE_URL=https://integrate.api.nvidia.com/v1
#
# Image Extraction Environment Variables (optional)
# AIQ_EXTRACT_TABLES=false
# AIQ_EXTRACT_IMAGES=false
# AIQ_EXTRACT_CHARTS=false
#
# -----------------------------------------------------------------------------
# RAG Server and Ingestor URLs (required for knowledge layer)
# -----------------------------------------------------------------------------

# RAG_SERVER_URL=http://localhost:8081/v1
# RAG_INGEST_URL=http://localhost:8082/v1


# -----------------------------------------------------------------------------
# Frontend (UI) runtime configuration (Docker Compose)
# -----------------------------------------------------------------------------
# These variables are consumed by docker-compose.yaml.
# The compose files map them into the UI container as REQUIRE_AUTH and BACKEND_URL.

# Set to true to require OAuth login. False (default) uses a default user.
# REQUIRE_AUTH=false

# Backend URL used by the UI container.
# BACKEND_URL=http://aiq-agent:8000


# -----------------------------------------------------------------------------
# Backend configuration (Docker Compose)
# -----------------------------------------------------------------------------
# Workflow config file used by the backend server in Docker Compose.
# The compose stacks mount `configs/` into the container at `/app/configs`.
#
# Examples:
# - /app/configs/config_web_default_llamaindex.yml
# - /app/configs/config_web_frag.yml
# BACKEND_CONFIG=
#
# Optional NAT span request tag enrichment for aiq_api auth middleware:
# AIQ_TRACE_USER_IDENTITY_MODE=none
# AIQ_TRACE_USER_IDENTITY_HMAC_SECRET=
# AIQ_TRACE_CLIENT_ID_MODE=none
# AIQ_TRACE_CLIENT_ID_HMAC_SECRET=
# AIQ_TRACE_CLIENT_IP_HEADERS=x-real-ip,x-forwarded-for

# =============================================================================
# Red Hat fork additions
# =============================================================================
# Kept at the end of the file, in one block, so that upstream's own additions
# (which land mid-file) merge cleanly on each catch-up. Do not interleave these
# with the sections above.

# -----------------------------------------------------------------------------
# vLLM / OpenAI-compatible / Model-as-a-Service (MaaS) endpoints
# -----------------------------------------------------------------------------
# Used by configs/config_web_vllm.yml (launch with CONFIG_FILE=configs/config_web_vllm.yml).
# See docs/source/customization/vllm-migration.md for a full walkthrough and
# maas-kimi-k25.md for the Red Hat MaaS / Kimi K2.5 recipe.
# Leave this block commented out to use NVIDIA NIM (the default).
#
# VLLM_BASE_URL=http://localhost:8000
# VLLM_INTENT_BASE_URL=http://localhost:8000   # NAT cannot nest ${VAR:-${OTHER}}; set explicitly
# VLLM_API_KEY=no-key
#
# Per-role model overrides. All roles may point at the same served model.
# VLLM_INTENT_MODEL=meta-llama/Llama-3.1-8B-Instruct
# VLLM_RESEARCHER_MODEL=meta-llama/Llama-3.1-70B-Instruct
# VLLM_ORCHESTRATOR_MODEL=Qwen/Qwen2.5-72B-Instruct
# VLLM_WRITER_MODEL=meta-llama/Llama-3.1-70B-Instruct
# VLLM_SUMMARY_MODEL=meta-llama/Llama-3.1-8B-Instruct
#
# Per-role max_tokens. MUST be <= the server's --max-model-len or vLLM returns
# HTTP 400. This depends on how the endpoint was LAUNCHED, not on model size --
# throughput tuning routinely shrinks the served window well below what the model
# supports. Read the real value from `curl $VLLM_BASE_URL/v1/models`.
# Defaults below match the committed config (NIM scale); scale DOWN for
# constrained endpoints. See vllm-decisions.md (Decision 6).
# VLLM_INTENT_MAX_TOKENS=4096
# VLLM_RESEARCHER_MAX_TOKENS=16384
# VLLM_ORCHESTRATOR_MAX_TOKENS=128000
# VLLM_WRITER_MAX_TOKENS=16384
# VLLM_SUMMARY_MAX_TOKENS=512
#
# Per-call timeout (seconds) for intent classification. Raise for slow endpoints.
# VLLM_LLM_TIMEOUT=90
#
# Reasoning control. Leave unset (null) -- safe on ANY model. Setting it to false
# injects /no_think and is valid ONLY on Nemotron model names; against anything
# else (including the default Qwen orchestrator) it FAILS CONFIG LOAD. Measured
# to be a no-op for latency anyway -- see vllm-results.md.
# VLLM_THINKING=false

# -----------------------------------------------------------------------------
# Async deep research (Dask)
# -----------------------------------------------------------------------------
# Only deploy/entrypoint.py exports this. Running `nat serve` or scripts/start_e2e.sh
# directly bypasses that, in which case aiq_api creates a local Dask cluster and
# the chat researcher's inline submitter falls back to synchronous execution.
# NAT_DASK_SCHEDULER_ADDRESS=tcp://scheduler:8786

# -----------------------------------------------------------------------------
# Evaluation (optional)
# -----------------------------------------------------------------------------
# OpenAI key for the judge models used by `nat eval` runs.
# Not required for inference -- evaluation only.
# OPENAI_API_KEY=
